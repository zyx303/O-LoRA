{
  "data_config": {
    "data_type": "synthetic",
    "num_tasks": 5,
    "samples_per_task": 200,
    "max_length": 128,
    "validation_split": 0.2
  },
  
  "model_config": {
    "model_name": "t5-small",
    "predictor_type": "learned",
    "use_original_model": true,
    "hidden_dim": 256,
    "dropout": 0.1,
    "use_attention": true,
    "attention_heads": 8
  },
  
  "training_config": {
    "learning_rate": 1e-4,
    "batch_size": 32,
    "num_epochs": 50,
    "weight_decay": 1e-5,
    "warmup_steps": 1000,
    "use_focal_loss": false,
    "label_smoothing": 0.1,
    "focal_loss_alpha": 1.0,
    "focal_loss_gamma": 2.0
  },
  
  "validation_config": {
    "early_stopping_patience": 10,
    "early_stopping_min_delta": 1e-4,
    "log_interval": 100,
    "save_interval": 1000
  },
  
  "output_config": {
    "output_dir": "./task_id_predictor_output",
    "log_level": "INFO"
  },
  
  "task_mappings": {
    "uie_tasks": {
      "entity_extraction": 0,
      "sentiment_analysis": 1,
      "question_answering": 2,
      "text_summarization": 3,
      "machine_translation": 4
    },
    
    "benchmark_tasks": {
      "task_0": 0,
      "task_1": 1,
      "task_2": 2,
      "task_3": 3,
      "task_4": 4
    }
  },
  
  "class_to_task_mapping": {
    "0": 0, "1": 0, "2": 0,
    "3": 1, "4": 1, "5": 1,
    "6": 2, "7": 2, "8": 2,
    "9": 3, "10": 3, "11": 3,
    "12": 4, "13": 4, "14": 4
  }
}
